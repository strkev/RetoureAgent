# ==============================================================================
# Umgebungsvariablen-Vorlage (.env.example)
# Kopieren Sie diese Datei nach .env: cp .env.example .env
# ==============================================================================

# Optional: OpenAI API-Key
# Wird kein Key angegeben, läuft das System vollautomatisch im autarken Mock-Modus.
OPENAI_API_KEY=

# Optional: Eigener Endpoint (z. B. Azure OpenAI, LocalAI, vLLM, Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Modellname (Standard: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
